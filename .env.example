# Google OAuth client IDs (created in Google Cloud Console).
# Required for Google sign-in to work in Expo Go and dev builds.
# Copy this file to .env (which is gitignored) and fill in the values.

# iOS OAuth client ID — used when the app runs natively on iOS.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Android OAuth client ID — used when running on Android natively.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Web OAuth client ID — used by the Expo Go auth proxy and the web
# fallback. Always required.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
